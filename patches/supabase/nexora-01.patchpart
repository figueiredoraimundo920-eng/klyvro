+    };
+
+    void (async () => {
+      try {
+        const token = getDeviceToken();
+        deviceTokenRef.current = token;
+        const { data: claimed, error: claimError } = await supabase.rpc("klyvro_claim_profile", { p_token: token });
+        if (claimError) throw claimError;
+        const identity = Array.isArray(claimed) ? claimed[0] : null;
+        if (!identity || cancelled) return;
+        const slot = Number(identity.slot);
+        setProfileSlot(slot);
+        setProfile((current) => ({ ...current, name: String(identity.display_name || `Jogador ${slot}`) }));
+
+        const [{ data: profiles, error: profilesError }, { data: history, error: historyError }] = await Promise.all([
+          supabase.from("klyvro_profiles").select("slot,display_name,avatar_color,claimed").order("slot"),
+          supabase.from("klyvro_messages").select("id,server_id,channel_id,author_slot,author_name,body,created_at").order("created_at", { ascending: true }).limit(300),
+        ]);
+        if (profilesError) throw profilesError;
+        if (historyError) throw historyError;
+        if (profiles && !cancelled) setProfileRows(profiles as KlyvroProfileRow[]);
+        if (history && !cancelled) {
+          const grouped: Record<string, Message[]> = {};
+          for (const row of history) {
+            const message = rowToMessage(row as never);
+            grouped[message.channelId ?? "geral"] = mergeMessages(grouped[message.channelId ?? "geral"] ?? [], message);
+          }
+          setMessages((current) => ({ ...current, ...grouped }));
+        }
+
+        const realtime = supabase.channel("klyvro-community-v2", { config: { presence: { key: `slot-${slot}` } } });
+        channelRef = realtime;
