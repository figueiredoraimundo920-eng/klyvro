@@ -123,6 +125,36 @@
 const MAX_MESSAGE_LENGTH = 2000;
 const COUNTER_START = 1800;
 const createLocalId = (prefix: string) => `${prefix}-${Date.now()}-${Math.random().toString(36).slice(2, 9)}`;
+const REALTIME_CONFIG = { appId: "klyvro-public-p2p-v1" };
+const REALTIME_ROOM = "community-main";
+
+const validNetworkMessage = (value: unknown): value is NetworkMessage => {
+  if (!value || typeof value !== "object") return false;
+  const item = value as Partial<NetworkMessage>;
+  return typeof item.id === "string" && item.id.length <= 100
+    && typeof item.author === "string" && item.author.length <= 24
+    && typeof item.text === "string" && item.text.length > 0 && item.text.length <= MAX_MESSAGE_LENGTH
+    && typeof item.channelId === "string" && item.channelId.length <= 40
+    && (item.serverId === "kv" || item.serverId === "cp" || item.serverId === "mc");
+};
+
+const mergeMessages = (current: Message[], incoming: Message[]) => {
+  const byId = new Map(current.map((message) => [message.id, message]));
+  for (const message of incoming) {
+    const existing = byId.get(message.id);
+    if (!existing) byId.set(message.id, { ...message, avatarUrl: null });
+    else if (message.reactions) {
+      const reactions = { ...existing.reactions };
+      for (const [emoji, count] of Object.entries(message.reactions)) reactions[emoji] = Math.max(reactions[emoji] ?? 0, count);
+      byId.set(message.id, { ...existing, reactions });
+    }
+  }
+  return Array.from(byId.values()).slice(-150);
+};
+
+const historySnapshot = (source: Record<string, Message[]>) => Object.fromEntries(
+  Object.entries(source).map(([channelId, items]) => [channelId, items.slice(-100).map((message) => ({ ...message, avatarUrl: null }))]),
+);
 
